{
  "name": "faater",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Free, public, Qur'an-grounded Q&A system (EN + FA)",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeraFired/Faater.git"
  },
  "scripts": {
    "pipeline": "node pipeline/build-corpus.ts && node pipeline/build-translations.ts && node pipeline/build-lexicon.ts && node pipeline/build-d1.ts",
    "test": "node --test \"pipeline/tests/*.test.ts\" \"worker/tests/*.test.ts\"",
    "eval": "node pipeline/eval.ts",
    "ablate": "node pipeline/tools/ablate.ts",
    "ablate:fusion": "node pipeline/tools/ablate-fusion.ts",
    "eval:d1": "node pipeline/tools/eval-d1.ts",
    "eval:issues": "node pipeline/tools/eval-issues.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
